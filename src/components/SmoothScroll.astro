---
/** Lenis smooth scrolling for the whole site, run on GSAP's ticker and wired to ScrollTrigger; off for reduced motion. */
---
<script>
  import Lenis from 'lenis';
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  if (!reducedMotion) {
    const lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.9, anchors: true, autoRaf: false });
    (window as unknown as { lenis: Lenis }).lenis = lenis;
    // One loop: Lenis steps on GSAP's ticker, and ScrollTrigger reads Lenis's scroll.
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000), false, true); // first, so every other frame callback reads this frame's scroll
    gsap.ticker.lagSmoothing(0);
    // Pause while the full-screen menu locks scrolling.
    new MutationObserver(() => {
      document.documentElement.style.overflow === 'hidden' ? lenis.stop() : lenis.start();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['style'] });
  }
</script>

<style is:global>
  html.lenis, html.lenis body { height: auto; }
  .lenis:not(.lenis-autoToggle).lenis-stopped { overflow: clip; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-smooth iframe { pointer-events: none; }
</style>
