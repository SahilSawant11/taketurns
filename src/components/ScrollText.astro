---
/**
 * Oversized statement whose words light up as it scrolls through the viewport.
 * Words wrapped in *asterisks* light up in the accent colour.
 * Fully lit, with no scripting needed, under reduced motion.
 */
interface Props { text: string; as?: 'h2' | 'p'; id?: string }
const { text, as: Tag = 'p', id } = Astro.props;
const words = text.split(/\s+/).map((w) => ({ w: w.replace(/\*/g, ''), accent: w.startsWith('*') || w.endsWith('*') }));
---
<Tag class="st" id={id} data-st>
  <span class="visually-hidden">{text.replace(/\*/g, '')}</span>
  {words.map((x) => <span class:list={['st__w', { 'st__w--accent': x.accent }]} aria-hidden="true">{x.w} </span>)}
</Tag>

<style>
  .st {
    font-size: clamp(2.1rem, 1.2rem + 4vw, 5.4rem); font-weight: 500; text-transform: uppercase;
    letter-spacing: -0.045em; line-height: 0.96; margin: 0; max-width: 18ch;
  }
  .st__w { color: color-mix(in srgb, var(--ink) 22%, transparent); transition: color .35s ease; }
  .st__w.is-lit { color: var(--ink); }
  .st__w--accent.is-lit { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .st__w { color: var(--ink); }
    .st__w--accent { color: var(--accent); }
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...document.querySelectorAll<HTMLElement>('[data-st]')].map((el) => ({
      el,
      words: [...el.querySelectorAll<HTMLElement>('.st__w')],
    }));
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = innerHeight;
      items.forEach(({ el, words }) => {
        const r = el.getBoundingClientRect();
        // 0 when the block's top enters at 85% of the viewport, 1 when its bottom reaches 40%.
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.45)));
        const lit = Math.round(p * words.length * 1.15);
        words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
      });
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
