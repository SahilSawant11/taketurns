---
import Base from '../layouts/Base.astro';
import WindingHero from '../components/WindingHero.astro';
import FloatingLeaf from '../components/FloatingLeaf.astro';
import ScrollText from '../components/ScrollText.astro';
import LayerDiagram from '../components/LayerDiagram.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Pending from '../components/Pending.astro';
import { materials, renderFor } from '../content/materials';
import { applications, projects, resources } from '../content/catalog';
import { site, services } from '../content/site';

const facts = [
  { n: site.yearsExperience, d: 'Years of engineering and project experience' },
  { n: String(materials.length).padStart(2, '0'), d: 'Material families: FRP, glass-lined steel, stainless' },
  { n: '01', d: 'Point of coordination, from concept engineering to delivery' },
];
---
<Base theme="dark">
  <WindingHero />
  <div data-float="hidden" data-float-at="0.9" aria-hidden="true"></div>

  <!-- 01 · Statement -->
  <section class="section tone-dark" data-chapter="01 · Empowering projects" data-float="statement" aria-label="Positioning">
    <div class="wrap">
      <p class="chapter__n">[01]</p>
      <ScrollText as="h2" text="Engineering performance through material science, design integrity and *application* *expertise.*" />
      <div class="intro">
        <p class="lede">
          We start from what the equipment has to hold and the conditions it faces. From there we choose the right
          material, the right design and the right manufacturing partner. Because we're asset-light and vendor-neutral,
          the recommendation follows the duty, not a factory's order book.
        </p>
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.n}</dt>
              <dd class="label">{f.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 02 · Materials -->
  <section class="section tone-light" id="materials" data-chapter="02 · Materials" data-float="materials" aria-labelledby="c2">
    <div class="wrap">
      <div class="chapter">
        <p class="chapter__n">[02] The materials</p>
        <h2 id="c2">Three ways to <em>protect what's inside</em></h2>
      </div>
      <ol class="mats">
        {materials.map((m, i) => (
          <li>
            <a class="mat" href={`/materials/${m.slug}/`}>
              <span class="label">{String(i + 1).padStart(2, '0')} / {m.short}</span>
              <span class="mat__name">{m.name}</span>
              <img class="mat__img" src={`/renders/${m.slug}-section.jpg`} alt={`3D cutaway of a ${m.name.toLowerCase()} wall, layers separated`} loading="lazy" decoding="async" />
              <span class="mat__one">{m.oneLiner}</span>
              <span class="mat__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 · Inside the wall -->
  <section class="section tone-dark" data-chapter="03 · Inside the wall" data-float="wall" aria-labelledby="c3">
    <div class="wrap">
      <div class="chapter">
        <p class="chapter__n">[03] Inside the wall</p>
        <h2 id="c3">Layer <em>by layer</em></h2>
        <p class="lede">Select a layer to see what it does. Separate the layers to see how each wall is put together.</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Material">
          {materials.map((m, i) => (
            <button role="tab" id={`tab-${m.slug}`} aria-controls={`tp-${m.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              {m.name}
            </button>
          ))}
        </div>
        {materials.map((m, i) => (
          <div role="tabpanel" id={`tp-${m.slug}`} aria-labelledby={`tab-${m.slug}`} hidden={i !== 0} tabindex="0">
            <LayerDiagram material={m} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 · Why it fits -->
  <section class="section tone-green" data-chapter="04 · Why it fits" data-float="fits" aria-labelledby="c4">
    <div class="wrap">
      <div class="chapter">
        <p class="chapter__n">[04] Why it fits</p>
        <h2 id="c4">Duty first, <em>material second</em></h2>
        <p class="lede">Every property comes with conditions. Here's where each material is usually considered, and what to check before deciding.</p>
      </div>
      <div class="fits">
        {materials.map((m) => (
          <div class="fit">
            <h3><span class={`tag tag--${m.slug}`}>{m.short}</span> {m.name}</h3>
            <div>
              <p class="label">Often considered for</p>
              <ul>{m.goodFitFor.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <p class="label">Check first</p>
              <ul class="fit__check">{m.checkFirst.map((x) => <li>{x}</li>)}</ul>
            </div>
            <a class="label label--br" href={`/materials/${m.slug}/#properties`}>{m.short} properties</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · Applications (horizontal strip) -->
  <section class="section tone-dark apps-sec" data-chapter="05 · Applications" data-float="apps" aria-labelledby="c5">
    <div class="wrap apps-head">
      <div class="chapter">
        <p class="chapter__n">[05] Applications</p>
        <h2 id="c5">Where it <em>goes to work</em></h2>
      </div>
      <div class="apps-nav">
        <button type="button" class="label label--br" data-strip="-1" aria-label="Previous applications">Prev</button>
        <button type="button" class="label label--br" data-strip="1" aria-label="Next applications">Next</button>
      </div>
    </div>
    <ul class="strip" data-strip-track>
      {applications.map((a, i) => (
        <li>
          <a class="app" href={`/applications/${a.slug}/`}>
            <ImageSlot need={a.imageNeed} ratio="4 / 3" render={renderFor(a.slug)} />
            <span class="label">{String(i + 1).padStart(2, '0')} · {a.materials.map((m) => m.toUpperCase()).join(' / ')}</span>
            <span class="app__name">{a.name}</span>
            <span class="muted app__c">{a.challenge}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 06 · How we work -->
  <section class="section tone-light" data-chapter="06 · How we work" data-float="work" aria-labelledby="c6">
    <div class="wrap">
      <div class="chapter">
        <p class="chapter__n">[06] How we work</p>
        <h2 id="c6">One partner, <em>concept to delivery</em></h2>
        <p class="lede">Shaktinova engineers the solution and runs the project, and qualified manufacturing partners build it under our oversight.</p>
      </div>
      <ol class="rows">
        {services.map((s, i) => (
          <li>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 · Proof -->
  <section class="section tone-light section--tint" data-chapter="07 · Proof" data-float="proof" aria-labelledby="c7">
    <div class="wrap">
      <div class="chapter">
        <p class="chapter__n">[07] Proof</p>
        <h2 id="c7">Show the <em>work</em></h2>
      </div>
      <div class="grid grid--3">
        <div class="card proof">
          <h3>Case studies</h3>
          <p class="muted">Challenge, solution, material and outcome for real installations.</p>
          {projects.length ? <a href="/projects/">View projects →</a> : <Pending note="original project photos + client, location, outcome and permission" />}
        </div>
        <div class="card proof">
          <h3>Technical documents</h3>
          <p class="muted">Company profile, brochures and datasheets.</p>
          {resources.length ? <a href="/resources/">View resources →</a> : <Pending note="company profile / datasheet PDFs in /public/downloads" />}
        </div>
        <div class="card proof">
          <h3>Standards & quality</h3>
          <p class="muted">The design standards and quality plans the work follows.</p>
          <Pending note="standards worked to, partner qualifications, certificates" />
        </div>
      </div>
    </div>
  </section>

  <!-- 08 · Finale -->
  <section class="section tone-green finale" data-chapter="08 · Start a project" data-float="finale" data-float-ref=".finale__stage" aria-label="Start a project">
    <div class="wrap">
      <ScrollText text="Tell us what it has to hold. We'll engineer *the* *rest.*" />
      <div class="finale__row">
        <p class="lede">Share the medium, environment, size, location and timeline. Drawings or a spec sheet help. We'll come back with questions or a recommended direction.</p>
        <div class="finale__cta">
          <a class="btn" href="/contact/">Start a project inquiry <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/materials/">Compare materials</a>
        </div>
      </div>
      <!-- Clear stage where the leaf comes to rest (see scripts/leaf.ts). -->
      <div class="finale__stage" aria-hidden="true">
        <p class="label">Kept clean by design</p>
      </div>
    </div>
  </section>
  <div data-float="hidden" data-float-at="0.15" aria-hidden="true"></div>
  <FloatingLeaf />
</Base>

<style>
  .intro { display: grid; gap: 48px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: start; margin-top: clamp(56px, 8vw, 120px); }
  .facts { margin: 0; display: grid; }
  .facts > div { display: grid; grid-template-columns: minmax(0, 9rem) 1fr; gap: 20px; align-items: baseline; padding: 18px 0; border-top: 1px solid var(--line); }
  .facts dt { font-size: clamp(2.6rem, 1.8rem + 2.6vw, 4.4rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .facts dd { margin: 0; }

  .mats { list-style: none; padding: 0; margin: 0; border-bottom: 1px solid var(--ink); }
  .mat {
    display: grid; grid-template-columns: 8rem 1fr minmax(0, 260px) minmax(0, 280px) 2rem; gap: 24px; align-items: center;
    padding: clamp(22px, 3vw, 40px) 0; border-top: 1px solid var(--ink); text-decoration: none; transition: color .2s;
  }
  .mat__name { font-size: clamp(1.7rem, 1rem + 2.6vw, 3.4rem); font-weight: 500; text-transform: uppercase; letter-spacing: -0.035em; line-height: .95; }
  .mat__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .mat__one { color: var(--muted); font-size: .95rem; }
  .mat__go { font-size: 1.6rem; transition: transform .25s; }
  .mat:hover { color: var(--accent); }
  .mat:hover .mat__go { transform: translateX(6px); }
  @media (max-width: 960px) {
    .mat { grid-template-columns: 1fr auto; gap: 12px; }
    .mat .label { grid-column: 1 / -1; }
    .mat__img { grid-column: 1 / -1; order: 3; }
    .mat__one { grid-column: 1 / -1; order: 4; }
  }

  .tabs__list { display: inline-flex; gap: 0; border: 1px solid var(--line); margin-bottom: 40px; flex-wrap: wrap; }
  .tabs__list button {
    border: 0; background: none; padding: 12px 18px; min-height: 44px; cursor: pointer; color: var(--muted);
    font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
  }
  .tabs__list button[aria-selected='true'] { background: var(--ink); color: var(--paper); }

  .fits { display: grid; gap: clamp(28px, 3vw, 48px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .fit { display: grid; gap: 22px; align-content: start; padding-top: 20px; border-top: 1px solid var(--ink); }
  .fit h3 { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: var(--step-2); }
  .fit .label { margin-bottom: 10px; }
  .fit ul { list-style: none; display: grid; gap: 8px; }
  .fit li { padding-left: 18px; position: relative; }
  .fit li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; background: var(--ink); }
  .fit__check li::before { background: none; border: 1px solid var(--ink); }
  .fit > a { color: var(--ink); text-decoration: none; }
  .fit > a:hover { color: var(--accent); }

  .apps-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .apps-nav { display: flex; gap: 20px; margin-bottom: clamp(40px, 6vw, 88px); }
  .apps-nav button { background: none; border: 0; color: var(--ink); cursor: pointer; min-height: 44px; padding: 0; }
  .apps-nav button:hover { color: var(--accent); }
  .strip {
    list-style: none; margin: 0; padding: 0 var(--gutter) 8px; display: grid; grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 34vw, 520px); gap: clamp(16px, 2vw, 28px); overflow-x: auto;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip li { scroll-snap-align: start; }
  .app { display: grid; gap: 12px; text-decoration: none; }
  .app__name { font-size: var(--step-2); font-weight: 500; text-transform: uppercase; letter-spacing: -0.03em; line-height: 1; }
  .app__c { font-size: .92rem; }
  .app:hover .app__name { color: var(--accent); }

  .rows { list-style: none; padding: 0; margin: 0; border-bottom: 1px solid var(--ink); }
  .rows li { display: grid; grid-template-columns: 4rem minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; align-items: baseline; padding: clamp(22px, 3vw, 36px) 0; border-top: 1px solid var(--ink); }
  .rows h3 { font-size: clamp(1.3rem, 1rem + 1.4vw, 2.2rem); text-transform: uppercase; letter-spacing: -0.03em; line-height: 1; }
  @media (max-width: 760px) { .rows li { grid-template-columns: 1fr; gap: 10px; } }

  .proof { display: grid; gap: 12px; align-content: start; }
  .proof h3 { font-size: var(--step-2); }

  .finale { padding-block: clamp(120px, 16vw, 240px); }
  .finale__row { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); align-items: end; margin-top: clamp(48px, 7vw, 96px); }
  .finale__stage { height: clamp(420px, 70vh, 760px); margin-top: clamp(48px, 8vw, 120px); display: flex; align-items: flex-end; justify-content: center; border-top: 1px solid var(--line); padding-bottom: 8px; }
  .finale__cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-start; }
  @media (min-width: 900px) { .finale__cta { justify-content: flex-end; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const activate = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activate(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus();
        activate(n);
      });
    });
  });

  const track = document.querySelector<HTMLElement>('[data-strip-track]');
  document.querySelectorAll<HTMLButtonElement>('[data-strip]').forEach((b) =>
    b.addEventListener('click', () => {
      const item = track?.querySelector('li');
      if (!track || !item) return;
      const step = item.getBoundingClientRect().width + 24;
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: Number(b.dataset.strip) * step, behavior: smooth ? 'smooth' : 'auto' });
    }),
  );
</script>
