---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page-hero">
    <div class="wrap stack" style="--space:1.4rem">
      <p class="eyebrow">404</p>
      <h1>This page isn't here.</h1>
      <p class="lede">It may have moved. Try the materials overview, or go straight to an inquiry.</p>
      <p style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--ghost" href="/materials/">Materials</a>
        <a class="btn btn--ghost" href="/contact/">Project inquiry</a>
      </p>
    </div>
  </section>
</Base>
